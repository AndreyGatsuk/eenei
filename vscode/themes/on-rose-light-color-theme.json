  "tokenColors": [
    {
      "name": "Regular text and embedded languages",
      "scope": [
        "source",
        "text",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#292720"
      }
    },
    {
      "name": "Important: control flow, ?, macros, unsafe",
      "scope": [
        "keyword.control",
        "entity.name.function.macro",
        "entity.name.type.macro",
        "storage.control.clojure",
        "meta.control.flow.pug storage.type.function.pug",
        "keyword.operator.question.rust",
        "keyword.other.unsafe.rust"
      ],
      "settings": {
        "foreground": "#376b93"
      }
    },
    {
      "name": "Bold: type names at their definition, top-level functions",
      "scope": [
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.trait",
        "entity.name.type.declaration",
        "meta.impl.rust > entity.name.type",
        "meta.toplevel.rust meta.function.definition.rust entity.name.function",
        "entity.name.type.class",
        "meta.toplevel.python meta.function.python entity.name.function"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic: comments",
      "scope": [
        "comment",
        "comment punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#686354",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.definition.char",
        "constant.character.escape",
        "storage.type.string.python",
        "string.regexp keyword",
        "string.regexp punctuation",
        "property.value.dotenv"
      ],
      "settings": {
        "foreground": "#925471"
      }
    },
    {
      "name": "Configuration keys and embedded expression names",
      "scope": [
        "support.type.property-name.json",
        "string variable",
        "variable.interpolation.dotenv"
      ],
      "settings": {
        "foreground": "#292720"
      }
    },
    {
      "name": "YAML: mapping keys, numbers, booleans and null",
      "scope": [
        "entity.name.tag.yaml",
        "source.yaml constant.numeric",
        "source.yaml constant.language",
        "meta.embedded.block.yaml constant.numeric",
        "meta.embedded.block.yaml constant.language",
        "meta.embedded.yaml constant.numeric",
        "meta.embedded.yaml constant.language"
      ],
      "settings": {
        "foreground": "#292720"
      }
    },
    {
      "name": "Insignificant: keywords, syntax operators, punctuation",
      "scope": [
        "keyword",
        "storage",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "punctuation",
        "meta.brace",
        "meta.impl.rust keyword.control",
        "variable.language.super",
        "meta.use entity.name.namespace",
        "entity.name.type.lifetime",
        "meta.attribute.rust",
        "meta.attribute.rust string",
        "meta.attribute.rust punctuation.definition.string",
        "entity.name.namespace.python",
        "constant.character.format.placeholder.other.python",
        "meta.function.decorator.python",
        "meta.function.decorator.python string",
        "meta.function.decorator.python punctuation.definition.string",
        "entity.name.tag.yaml punctuation.definition.string",
        "source.yaml keyword.control",
        "meta.embedded.block.yaml keyword.control",
        "meta.embedded.yaml keyword.control",
        "keyword.control.directive.include",
        "entity.other.jinja.delimiter",
        "source.mdx string.other.begin",
        "source.mdx string.other.end",
        "meta.attribute.directive.vue punctuation.definition.string",
        "meta.attribute.directive.control.vue punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#606b78"
      }
    },
    {
      "name": "Regular: math, comparison, logic operators",
      "scope": [
        "keyword.operator.math",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.exponent",
        "keyword.operator.assignment.compound",
        "keyword.operator.assignment.rust",
        "keyword.operator.computation.nix",
        "keyword.operator.unary.nix"
      ],
      "settings": {
        "foreground": "#292720"
      }
    },
    {
      "name": "Italic insignificant: doc comments",
      "scope": [
        "comment.line.documentation",
        "comment.block.documentation",
        "comment.line.documentation punctuation.definition.comment",
        "comment.block.documentation punctuation.definition.comment",
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string",
        "comment.line.double-dash.documentation.lua",
        "comment.line.double-dash.documentation.lua punctuation.definition.comment",
        "comment.block.javadoc.java",
        "comment.block.javadoc.java punctuation.definition.comment",
        "comment.line.double-slash.documentation.cpp",
        "comment.line.double-slash.documentation.cpp punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#70695f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Document navigation: headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#376b93",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Document navigation: links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title",
        "constant.other.reference.link.markdown",
        "string.other.link.destination.mdx"
      ],
      "settings": {
        "foreground": "#376b93",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Document code spans",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#925471"
      }
    },
    {
      "name": "Document quotations",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#686354"
      }
    },
    {
      "name": "Diff additions retain their status color",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted",
        "punctuation.definition.to-file"
      ],
      "settings": {
        "foreground": "#478f00"
      }
    },
    {
      "name": "Diff removals retain their status color",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted",
        "punctuation.definition.from-file"
      ],
      "settings": {
        "foreground": "#f27983"
      }
    },
    {
      "name": "Diff navigation",
      "scope": [
        "meta.diff.range",
        "meta.diff.range punctuation"
      ],
      "settings": {
        "foreground": "#376b93"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ]
}
