      "filename": "graphql.language-configuration.json"
    }
  ],
  "licenses": [
    {
      "source": "https://raw.githubusercontent.com/graphql/vscode-graphql/66e9d69b76c237714db0e606fa7ac32fc4fa3a94/LICENSE",
      "filename": "LICENSE.txt"
    }
  ]
}
