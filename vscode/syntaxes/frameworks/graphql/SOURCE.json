        "scopeName": "source.graphql"
      }
    }
  ],
  "languages": [
    {
      "id": "graphql",
      "extensions": [
        ".gql",
        ".graphql",
        ".graphqls"
      ],
      "aliases": [
        "GraphQL",
        "graphql"
      ],
      "configuration": "./syntaxes/frameworks/graphql/graphql.language-configuration.json"
    }
  ],
  "configurations": [
    {
