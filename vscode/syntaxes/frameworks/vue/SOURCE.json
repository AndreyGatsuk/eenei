{
  "id": "vue",
  "scope": "text.html.vue",
  "sample": "sample.vue",
  "extension": "Vue.volar",
  "repository": "https://github.com/vuejs/language-tools",
  "grammars": [
    {
      "scopeName": "text.html.vue",
      "url": "https://raw.githubusercontent.com/vuejs/language-tools/c59f9908b4912ee20141b53a99b1ce485bff0dc7/extensions/vscode/syntaxes/vue.tmLanguage.json",
      "format": "textmate",
      "injectTo": [],
      "contribution": {
        "language": "vue",
        "scopeName": "text.html.vue",
        "embeddedLanguages": {
          "text.html.vue": "vue",
          "text": "plaintext",
          "text.html.derivative": "html",
          "text.html.markdown": "markdown",
          "text.pug": "jade",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.css.less": "less",
          "source.sass": "sass",
          "source.stylus": "stylus",
          "source.postcss": "postcss",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.js.jsx": "javascriptreact",
          "source.tsx": "typescriptreact",
          "source.coffee": "coffeescript",
          "meta.tag.js": "jsx-tags",
          "meta.tag.tsx": "jsx-tags",
          "meta.tag.without-attributes.js": "jsx-tags",
          "meta.tag.without-attributes.tsx": "jsx-tags",
          "source.json": "json",
          "source.json.comments": "jsonc",
          "source.json5": "json5",
          "source.yaml": "yaml",
          "source.toml": "toml",
          "source.graphql": "graphql"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag"
        ]
      }
    },
    {
      "scopeName": "vue.directives",
      "url": "https://raw.githubusercontent.com/vuejs/language-tools/c59f9908b4912ee20141b53a99b1ce485bff0dc7/extensions/vscode/syntaxes/vue-directives.json",
      "format": "textmate",
      "injectTo": [
        "text.html.vue",
        "text.html.markdown",
        "text.html.derivative",
        "text.pug"
      ],
      "contribution": {
        "scopeName": "vue.directives",
        "injectTo": [
          "text.html.vue",
          "text.html.markdown",
          "text.html.derivative",
          "text.pug"
        ]
      }
    },
    {
      "scopeName": "vue.interpolations",
      "url": "https://raw.githubusercontent.com/vuejs/language-tools/c59f9908b4912ee20141b53a99b1ce485bff0dc7/extensions/vscode/syntaxes/vue-interpolations.json",
      "format": "textmate",
      "injectTo": [
        "text.html.vue",
        "text.html.markdown",
        "text.html.derivative",
        "text.pug"
      ],
      "contribution": {
        "scopeName": "vue.interpolations",
        "injectTo": [
          "text.html.vue",
          "text.html.markdown",
          "text.html.derivative",
          "text.pug"
        ]
      }
    },
    {
      "scopeName": "vue.sfc.script.leading-operator-fix",
      "url": "https://raw.githubusercontent.com/vuejs/language-tools/c59f9908b4912ee20141b53a99b1ce485bff0dc7/extensions/vscode/syntaxes/vue-sfc-script-leading-operator-fix.json",
      "format": "textmate",
      "injectTo": [
        "text.html.vue"
      ],
      "contribution": {
        "scopeName": "vue.sfc.script.leading-operator-fix",
        "injectTo": [
          "text.html.vue"
        ]
      }
    },
    {
      "scopeName": "vue.sfc.style.variable.injection",
      "url": "https://raw.githubusercontent.com/vuejs/language-tools/c59f9908b4912ee20141b53a99b1ce485bff0dc7/extensions/vscode/syntaxes/vue-sfc-style-variable-injection.json",
      "format": "textmate",
      "injectTo": [
        "text.html.vue"
      ],
      "contribution": {
        "scopeName": "vue.sfc.style.variable.injection",
        "injectTo": [
          "text.html.vue"
        ]
      }
    }
  ],
  "languages": [
    {
      "id": "vue",
      "extensions": [
        ".vue"
      ],
      "configuration": "./syntaxes/frameworks/vue/vue.language-configuration.json"
    }
  ],
  "configurations": [
    {
      "source": "https://raw.githubusercontent.com/vuejs/language-tools/c59f9908b4912ee20141b53a99b1ce485bff0dc7/extensions/vscode/languages/vue-language-configuration.json",
      "filename": "vue.language-configuration.json"
    }
  ],
  "licenses": [
    {
      "source": "https://raw.githubusercontent.com/vuejs/language-tools/c59f9908b4912ee20141b53a99b1ce485bff0dc7/extensions/vscode/LICENSE",
      "filename": "LICENSE.txt"
    }
  ]
}
