{
  "scopeName": "theme-lab.injection.markdown.zig",
  "injectionSelector": "L:text.html.markdown -markup.fenced_code.block.markdown",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "^(\\s*)(`{3,}|~{3,})\\s*(?i:zig|zon)\\s*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.markdown"
        }
      },
      "end": "^\\1\\2\\s*$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "meta.embedded.block.zig",
      "patterns": [
        {
          "include": "source.zig"
        }
      ]
    }
  ]
}
