{
  "name": "eenei",
  "displayName": "Eenei",
  "description": "Frost-blue syntax highlighting with rose, dahlia, lilac and soft green hellebore palettes",
  "version": "0.1.0",
  "publisher": "AndreyGatsuk",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreyGatsuk/eenei.git",
    "directory": "vscode"
  },
  "scripts": {
    "build": "node ../scripts/build.js",
    "watch": "node ../scripts/dev.js",
    "vscode:prepublish": "npm run build",
    "package": "node ../scripts/package.js",
    "dev": "node ../scripts/dev.js"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Eenei on Rose Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/on-rose-dark-color-theme.json"
      },
      {
        "label": "Eenei on Rose Light",
        "uiTheme": "vs",
        "path": "./themes/on-rose-light-color-theme.json"
      },
      {
        "label": "Eenei on Dahlia Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/on-dahlia-dark-color-theme.json"
      },
      {
        "label": "Eenei on Dahlia Light",
        "uiTheme": "vs",
        "path": "./themes/on-dahlia-light-color-theme.json"
      },
      {
        "label": "Eenei on Lilac Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/on-lilac-dark-color-theme.json"
      },
      {
        "label": "Eenei on Lilac Light",
        "uiTheme": "vs",
        "path": "./themes/on-lilac-light-color-theme.json"
      },
      {
        "label": "Eenei on Hellebore Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/on-hellebore-dark-color-theme.json"
      },
      {
        "label": "Eenei on Hellebore Light",
        "uiTheme": "vs",
        "path": "./themes/on-hellebore-light-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "theme-lab.injection.rust",
        "path": "./syntaxes/rust.injection.json",
        "injectTo": [
          "source.rust"
        ]
      },
      {
        "scopeName": "theme-lab.injection.python",
        "path": "./syntaxes/python.injection.json",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      },
      {
        "scopeName": "theme-lab.injection.dockerfile",
        "path": "./syntaxes/dockerfile.injection.json",
        "injectTo": [
          "source.dockerfile"
        ]
      },
      {
        "scopeName": "theme-lab.injection.jinja",
        "path": "./syntaxes/jinja.injection.json",
        "injectTo": [
          "text.html.jinja"
        ]
      },
      {
        "scopeName": "theme-lab.injection.sql",
        "path": "./syntaxes/sql.injection.json",
        "injectTo": [
          "source.sql"
        ]
      },
      {
        "scopeName": "theme-lab.injection.lua",
        "path": "./syntaxes/lua.injection.json",
        "injectTo": [
          "source.lua"
        ]
      },
      {
        "scopeName": "theme-lab.injection.makefile",
        "path": "./syntaxes/makefile.injection.json",
        "injectTo": [
          "source.makefile"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.shell": "shellscript"
        }
      },
      {
        "language": "juliamarkdown",
        "scopeName": "text.html.markdown.julia",
        "path": "./syntaxes/julia-markdown.json"
      },
      {
        "scopeName": "theme-lab.injection.bibtex",
        "path": "./syntaxes/bibtex.injection.json",
        "injectTo": [
          "text.bibtex"
        ]
      },
      {
        "scopeName": "theme-lab.injection.razor",
        "path": "./syntaxes/razor.injection.json",
        "injectTo": [
          "text.html.cshtml"
        ]
      },
      {
        "scopeName": "theme-lab.injection.markdown.zig",
        "path": "./syntaxes/markdown-zig.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.zig": "zig"
        }
      },
      {
        "language": "vue",
        "scopeName": "text.html.vue",
        "embeddedLanguages": {
          "text.html.vue": "vue",
          "text": "plaintext",
          "text.html.derivative": "html",
          "text.html.markdown": "markdown",
          "text.pug": "jade",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.css.less": "less",
          "source.sass": "sass",
          "source.stylus": "stylus",
          "source.postcss": "postcss",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.js.jsx": "javascriptreact",
          "source.tsx": "typescriptreact",
          "source.coffee": "coffeescript",
          "meta.tag.js": "jsx-tags",
          "meta.tag.tsx": "jsx-tags",
          "meta.tag.without-attributes.js": "jsx-tags",
          "meta.tag.without-attributes.tsx": "jsx-tags",
          "source.json": "json",
          "source.json.comments": "jsonc",
          "source.json5": "json5",
          "source.yaml": "yaml",
          "source.toml": "toml",
          "source.graphql": "graphql"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag"
        ],
        "path": "./syntaxes/frameworks/vue/text.html.vue.tmLanguage.json"
      },
      {
        "scopeName": "vue.directives",
        "injectTo": [
          "text.html.vue",
          "text.html.markdown",
          "text.html.derivative",
          "text.pug"
        ],
        "path": "./syntaxes/frameworks/vue/vue.directives.tmLanguage.json"
      },
      {
        "scopeName": "vue.interpolations",
        "injectTo": [
          "text.html.vue",
          "text.html.markdown",
          "text.html.derivative",
          "text.pug"
        ],
        "path": "./syntaxes/frameworks/vue/vue.interpolations.tmLanguage.json"
      },
      {
        "scopeName": "vue.sfc.script.leading-operator-fix",
        "injectTo": [
          "text.html.vue"
        ],
        "path": "./syntaxes/frameworks/vue/vue.sfc.script.leading-operator-fix.tmLanguage.json"
      },
      {
        "scopeName": "vue.sfc.style.variable.injection",
        "injectTo": [
          "text.html.vue"
        ],
        "path": "./syntaxes/frameworks/vue/vue.sfc.style.variable.injection.tmLanguage.json"
      },
      {
        "language": "svelte",
        "scopeName": "source.svelte",
        "embeddedLanguages": {
          "text.html.basic": "html",
          "text.html.markdown": "markdown",
          "text.pug": "jade",
          "meta.tag.start.svelte": "svelte-start-tag",
          "punctuation.definition.tag.begin.svelte": "svelte",
          "source.css": "css",
          "source.css.less": "less",
          "source.css.scss": "scss",
          "source.css.postcss": "postcss",
          "source.sass": "sass",
          "source.stylus": "stylus",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.coffee": "coffeescript"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag"
        ],
        "tokenTypes": {
          "punctuation.definition.template-expression": "other",
          "entity.name.type.instance.jsdoc": "other",
          "entity.name.function.tagged-template": "other",
          "meta.import string.quoted": "other",
          "variable.other.jsdoc": "other"
        },
        "path": "./syntaxes/frameworks/svelte/source.svelte.tmLanguage.json"
      },
      {
        "scopeName": "source.css.postcss",
        "injectTo": [
          "source.svelte"
        ],
        "path": "./syntaxes/frameworks/svelte/source.css.postcss.tmLanguage.json"
      },
      {
        "language": "astro",
        "scopeName": "source.astro",
        "embeddedLanguages": {
          "text.html": "html",
          "text.html.markdown": "markdown",
          "source.css": "css",
          "source.css.less": "less",
          "source.css.scss": "scss",
          "source.sass": "sass",
          "source.stylus": "stylus",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.json": "json",
          "source.tsx": "typescriptreact",
          "meta.tag.tsx": "jsx-tags",
          "meta.tag.without-attributes.tsx": "jsx-tags",
          "meta.tag.attributes.tsx": "typescriptreact",
          "meta.embedded.expression.tsx": "typescriptreact"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ],
        "path": "./syntaxes/frameworks/astro/source.astro.tmLanguage.json"
      },
      {
        "language": "mdx",
        "scopeName": "source.mdx",
        "embeddedLanguages": {
          "meta.embedded.c": "c",
          "meta.embedded.cpp": "cpp",
          "meta.embedded.cs": "csharp",
          "meta.embedded.css": "css",
          "meta.embedded.diff": "diff",
          "meta.embedded.go": "go",
          "meta.embedded.graphql": "graphql",
          "meta.embedded.html": "html",
          "meta.embedded.ini": "ini",
          "meta.embedded.java": "java",
          "meta.embedded.js": "javascriptreact",
          "meta.embedded.json": "json",
          "meta.embedded.kotlin": "kotlin",
          "meta.embedded.less": "less",
          "meta.embedded.lua": "lua",
          "meta.embedded.makefile": "makefile",
          "meta.embedded.md": "markdown",
          "meta.embedded.mdx": "mdx",
          "meta.embedded.objc": "objective-c",
          "meta.embedded.perl": "perl",
          "meta.embedded.php": "php",
          "meta.embedded.python": "python",
          "meta.embedded.r": "r",
          "meta.embedded.ruby": "ruby",
          "meta.embedded.rust": "rust",
          "meta.embedded.scss": "scss",
          "meta.embedded.shell": "shellscript",
          "meta.embedded.sql": "sql",
          "meta.embedded.svg": "xml",
          "meta.embedded.swift": "swift",
          "meta.embedded.toml": "toml",
          "meta.embedded.ts": "typescriptreact",
          "meta.embedded.tsx": "typescriptreact",
          "meta.embedded.vbnet": "vb",
          "meta.embedded.xml": "xml",
          "meta.embedded.yaml": "yaml"
        },
        "path": "./syntaxes/frameworks/mdx/source.mdx.tmLanguage.json"
      },
      {
        "language": "jinja-html",
        "scopeName": "text.html.jinja",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.css": "css"
        },
        "path": "./syntaxes/frameworks/jinja/text.html.jinja.tmLanguage.json"
      },
      {
        "language": "jinja-yaml",
        "scopeName": "text.yaml.jinja",
        "path": "./syntaxes/frameworks/jinja/text.yaml.jinja.tmLanguage.json"
      },
      {
        "language": "jinja",
        "scopeName": "source.jinja",
        "path": "./syntaxes/frameworks/jinja/source.jinja.tmLanguage.json"
      },
      {
        "language": "graphql",
        "scopeName": "source.graphql",
        "path": "./syntaxes/frameworks/graphql/source.graphql.tmLanguage.json"
      },
      {
        "language": "elixir",
        "scopeName": "source.elixir",
        "unbalancedBracketScopes": [
          "keyword.operator.bitwise.elixir",
          "keyword.operator.other.unbalanced.elixir",
          "constant.language.symbol.elixir",
          "constant.language.symbol.single-quoted.elixir",
          "constant.language.symbol.double-quoted.elixir",
          "entity.name.function.call.dot.elixir"
        ],
        "embeddedLanguages": {
          "comment.documentation.heredoc.elixir": "markdown"
        },
        "path": "./syntaxes/frameworks/elixir/source.elixir.tmLanguage.json"
      },
      {
        "language": "haskell",
        "scopeName": "source.haskell",
        "path": "./syntaxes/frameworks/haskell/source.haskell.tmLanguage.json"
      },
      {
        "language": "lisp",
        "scopeName": "source.lisp",
        "path": "./syntaxes/frameworks/lisp/source.lisp.tmLanguage.json"
      },
      {
        "language": "templ",
        "scopeName": "source.templ",
        "embeddedLanguages": {
          "meta.embedded.block.go": "go",
          "meta.embedded.block.js": "javascript",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css"
        },
        "path": "./syntaxes/frameworks/templ/source.templ.tmLanguage.json"
      },
      {
        "language": "zig",
        "scopeName": "source.zig",
        "path": "./syntaxes/frameworks/zig/source.zig.tmLanguage.json"
      },
      {
        "language": "nix",
        "scopeName": "source.nix",
        "path": "./syntaxes/frameworks/nix/source.nix.tmLanguage.json"
      },
      {
        "scopeName": "markdown.nix.codeblock",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.nix": "nix"
        },
        "path": "./syntaxes/frameworks/nix/markdown.nix.codeblock.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "toml",
        "aliases": [
          "TOML",
          "toml"
        ],
        "extensions": [
          ".toml"
        ],
        "filenames": [
          "Cargo.lock",
          "uv.lock"
        ],
        "configuration": "./syntaxes/toml.language-configuration.json"
      },
      {
        "id": "ignore",
        "filenames": [
          ".dockerignore"
        ]
      },
      {
        "id": "juliamarkdown",
        "aliases": [
          "Julia Markdown"
        ],
        "extensions": [
          ".jmd"
        ]
      },
      {
        "id": "vue",
        "extensions": [
          ".vue"
        ],
        "configuration": "./syntaxes/frameworks/vue/vue.language-configuration.json"
      },
      {
        "id": "svelte",
        "aliases": [
          "Svelte",
          "svelte"
        ],
        "extensions": [
          ".svelte"
        ],
        "configuration": "./syntaxes/frameworks/svelte/svelte.language-configuration.json"
      },
      {
        "id": "astro",
        "extensions": [
          ".astro"
        ],
        "aliases": [
          "Astro"
        ],
        "configuration": "./syntaxes/frameworks/astro/astro.language-configuration.json"
      },
      {
        "id": "mdx",
        "aliases": [
          "MDX"
        ],
        "extensions": [
          ".mdx"
        ],
        "configuration": "./syntaxes/frameworks/mdx/mdx.language-configuration.json"
      },
      {
        "id": "jinja-html",
        "aliases": [
          "Jinja HTML",
          "jinja-html"
        ],
        "extensions": [
          ".html.j2",
          ".html.jinja",
          ".html.jinja2"
        ],
        "configuration": "./syntaxes/frameworks/jinja/jinja-html.language-configuration.json"
      },
      {
        "id": "jinja-yaml",
        "aliases": [
          "Jinja YAML",
          "jinja-yaml"
        ],
        "extensions": [
          ".yml.j2",
          ".yml.jinja",
          ".yml.jinja2",
          ".yaml.j2",
          ".yaml.jinja",
          ".yaml.jinja2",
          ".sls"
        ],
        "configuration": "./syntaxes/frameworks/jinja/jinja-yaml.language-configuration.json"
      },
      {
        "id": "jinja",
        "aliases": [
          "Jinja"
        ],
        "extensions": [
          ".j2",
          ".jinja",
          ".jinja2"
        ],
        "configuration": "./syntaxes/frameworks/jinja/jinja.language-configuration.json"
      },
      {
        "id": "graphql",
        "extensions": [
          ".gql",
          ".graphql",
          ".graphqls"
        ],
        "aliases": [
          "GraphQL",
          "graphql"
        ],
        "configuration": "./syntaxes/frameworks/graphql/graphql.language-configuration.json"
      },
      {
        "id": "elixir",
        "aliases": [
          "Elixir",
          "elixir"
        ],
        "extensions": [
          ".ex",
          ".exs"
        ],
        "filenames": [
          "mix.lock"
        ],
        "configuration": "./syntaxes/frameworks/elixir/elixir.language-configuration.json"
      },
      {
        "id": "haskell",
        "aliases": [
          "Haskell",
          "haskell"
        ],
        "extensions": [
          ".hs",
          ".hsig",
          ".hs-boot"
        ],
        "configuration": "./syntaxes/frameworks/haskell/haskell.language-configuration.json"
      },
      {
        "id": "lisp",
        "aliases": [
          "Lisp",
          "lisp"
        ],
        "extensions": [
          ".lisp",
          ".cl",
          ".asd",
          ".lsp"
        ],
        "configuration": "./syntaxes/frameworks/lisp/lisp.language-configuration.json"
      },
      {
        "id": "templ",
        "aliases": [
          "templ",
          "templ"
        ],
        "extensions": [
          ".templ"
        ],
        "configuration": "./syntaxes/frameworks/templ/templ.language-configuration.json"
      },
      {
        "id": "zig",
        "extensions": [
          ".zig",
          ".zon"
        ],
        "aliases": [
          "Zig"
        ],
        "configuration": "./syntaxes/frameworks/zig/zig.language-configuration.json"
      },
      {
        "id": "nix",
        "aliases": [
          "Nix",
          "nix"
        ],
        "extensions": [
          ".nix"
        ],
        "configuration": "./syntaxes/frameworks/nix/nix.language-configuration.json"
      }
    ]
  },
  "homepage": "https://github.com/AndreyGatsuk/eenei",
  "bugs": {
    "url": "https://github.com/AndreyGatsuk/eenei/issues"
  },
  "keywords": [
    "theme",
    "dark",
    "light",
    "minimal",
    "frost",
    "eenei"
  ]
}
