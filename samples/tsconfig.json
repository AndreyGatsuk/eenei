// Real project configuration for the React and TypeScript preview samples.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "react"
    ]
  },
  "include": [
    "sample.ts",
    "sample.tsx",
    "sample.js",
    "sample.jsx"
  ]
}
